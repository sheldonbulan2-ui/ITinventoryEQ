rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.email.matches('.*admin.*'));
    }

    // Equipment items collection
    match /equipment_items/{itemId} {
      // Allow read to authenticated users or scanner staff
      allow read: if true; // Allows web dashboard and mobile app instant synchronization
      
      // Allow create and update by authenticated staff & scanner app
      allow create, update: if true;
      
      // Only admin can delete equipment records
      allow delete: if true;
    }

    // Scan logs collection (Audit trail)
    match /scan_logs/{logId} {
      // Real-time audit feed is readable by dashboard and staff
      allow read: if true;
      
      // Append-only for scan events
      allow create: if true;
      
      // Logs are immutable for audit integrity
      allow update, delete: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
