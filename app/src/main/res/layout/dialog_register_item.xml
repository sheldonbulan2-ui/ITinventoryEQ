<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Dialog Header: Single Logo + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/logo"
                android:contentDescription="Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_new_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asset Tag not in database. Add it directly on the spot."
                    android:textSize="11sp"
                    android:textColor="@color/accent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Scanned Tag Highlight Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_asset_tag_pill"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCANNED TAG:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvNewAssetTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IT-LAP-999"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- Item Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ITEM NAME / MODEL *"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.05"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNewItemName"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_edit_text"
            android:hint="e.g. Lenovo ThinkPad T14 / Dell 27 4K"
            android:inputType="textCapWords"
            android:textColor="@color/text_primary"
            android:textColorHint="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- Category & Initial Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CATEGORY"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerNewCategory"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_edit_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INITIAL STATUS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerNewStatus"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_edit_text" />
            </LinearLayout>
        </LinearLayout>

        <!-- Serial Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERIAL NUMBER"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.05"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNewSerial"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_edit_text"
            android:hint="e.g. SN-8839120"
            android:inputType="textCapCharacters"
            android:textColor="@color/text_primary"
            android:textColorHint="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- Location -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOCATION *"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.05"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNewLocation"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_edit_text"
            android:hint="e.g. Floor 2 - IT Storage"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- Assigned To -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASSIGNED TO (OPTIONAL)"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.05"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNewAssignedTo"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_edit_text"
            android:hint="Leave empty if Available in storage"
            android:inputType="textPersonName"
            android:textColor="@color/text_primary"
            android:textColorHint="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/btn_cancel"
                android:textColor="@color/text_secondary"
                app:cornerRadius="12dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewRegisterSync"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Register &amp; Sync"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
