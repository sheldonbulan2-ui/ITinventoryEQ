<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvQueueTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IT-LAP-001"
                android:background="@drawable/bg_asset_tag_pill"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tvQueuePendingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="PENDING SYNC"
                android:background="@drawable/bg_badge_maintenance"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/status_maintenance" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvQueueItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dell Latitude 5420"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvQueueAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Action: Check-Out / Assign"
                android:textSize="11sp"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQueueLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Floor 3 - Lab"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvQueueRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scanned while offline"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
