<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Elevated Brand Logo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/card_surface"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo"
                android:padding="16dp"
                android:contentDescription="IT Inventory Logo"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Clean Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IT Equipment Scanner &amp; Inventory Console"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="40dp" />

        <!-- Prominent 'CLICK ME' Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClickMe"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:text="CLICK ME"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:letterSpacing="0.08"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="18dp"
            app:elevation="6dp"
            app:icon="@drawable/ic_nav_scan"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/white" />

    </LinearLayout>

</RelativeLayout>
